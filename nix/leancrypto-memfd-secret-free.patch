From 99ae70d3e081536d158946988232c8b913987194 Mon Sep 17 00:00:00 2001
From: Markus Theil <theil.markus@gmail.com>
Date: Thu, 12 Nov 2026 16:11:58 +0100
Subject: [PATCH] Memory: release memfd_secret memory by its own fd

lc_free chose between munmap and free by lc_alloc_have_memfd_secret. Any
failing memfd_secret clears that flag process-wide - EMFILE of a process
out of descriptors suffices - and from then on lc_free handed every
memory mapped before to free(), which crashes. The ESDM server hit this
releasing its XDRBG after a period without free descriptors.

Only the fd stored with the allocation tells how it was made: munmap
whenever it is set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Markus Theil <theil.markus@gmail.com>
---
 internal/src/memory_support_linux.c | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/internal/src/memory_support_linux.c b/internal/src/memory_support_linux.c
index cad80402..22be82d7 100644
--- a/internal/src/memory_support_linux.c
+++ b/internal/src/memory_support_linux.c
@@ -47,8 +47,6 @@ struct lc_mem_def {
 
 #ifdef LC_USE_MEMFD_SECURE
 static int lc_alloc_have_memfd_secret = 1;
-#else
-static int lc_alloc_have_memfd_secret = 0;
 #endif
 
 static int alloc_aligned_secure_internal(void **memptr, size_t alignment,
@@ -182,11 +180,15 @@ static void lc_free_internal(void *ptr)
 	fd = mem->fd;
 	secure = mem->secure;
 
-	if (lc_alloc_have_memfd_secret && fd >= 0) {
+	/*
+	 * Only the fd tells how this memory was allocated: a failing
+	 * memfd_secret (EMFILE suffices) clears lc_alloc_have_memfd_secret
+	 * for later allocations, not for those already mapped.
+	 */
+	if (fd >= 0) {
 		lc_memset_secure(mem, 0, size);
 		munmap(mem, size);
-		if (fd != -1)
-			close(fd);
+		close(fd);
 	} else {
 		if (secure) {
 			lc_memset_secure(mem, 0, size);
-- 
