# Systemd configuration file
#
# The ESDM server does not depend on any other system
# services. Furthermore, we want to start it as early as possible
# in the boot cycle so that other services requiring
# random numbers (like SSHD, TLS-based services) benefit from it.
#
# Note on dependencies:
#
# The ESDM must be started after the generic kernel module loading target
# because the esdm_es.ko may be inserted. As this kernel module creates
# /dev/esdm_es and systemd can only define an access rule with DeviceAllow
# when this device is present, the ESDM must be started after the module
# loading call.
#
# Note: ESDM could be started as early as possible and already collect precious
# entropy during the early boot cycle, because with the -i and/or -s flags,
# it can wait until the /dev/esdm_es becomes available. Yet, this is currently
# not possible with a strict systemd device policy. If this changes, remove
# the marked Wants and After lines below.
#
# Also, if you are sure you do not want or need the esdm_es.ko module, you
# can also remove the marked Wants and After lines below to start the ESDM as
# early as possible.

[Unit]
Description=Entropy Source and DRNG Manager Daemon

@UNIT_SNIPPET@

StartLimitIntervalSec=500
StartLimitBurst=5

# Required to wait for insmod of esdm_es.ko - comment out if not needed
Wants=systemd-modules-load.service
After=systemd-modules-load.service

[Service]
@SERVICE_TYPE@
@EBPF_UNIT_SNIPPET@
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETGID CAP_SETUID CAP_KILL CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETGID CAP_SETUID CAP_KILL CAP_SYS_RESOURCE
DeviceAllow=/dev/esdm r
DeviceAllow=/dev/esdm_es r
DeviceAllow=/dev/hwrng r
DeviceAllow=/dev/null rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/tpmrm0 rw
DevicePolicy=strict
# --keep_ipc: the CUSE daemons are not coupled to this unit (only Wants=), so
# they must survive a server restart; hence do not remove the status SHM
# segment and semaphores they monitor at shutdown. (The RPC sockets are
# systemd-managed via socket activation and never removed by the server.)
ExecStart=@PATH@/esdm-server -f --pid /run/esdm-server.pid --syslog --memlock --keep_ipc -vvv
IPAddressDeny=any
LimitMEMLOCK=infinity
# The EGD clients hold their connection open for their entire lifetime, so the
# server keeps one descriptor per consumer on the system, next to the RPC ones.
# systemd's default of 1024 is below the number of EGD clients the server is
# willing to serve, which would turn into connections that are accepted and
# immediately dropped rather than into a clean limit.
LimitNOFILE=8192
LockPersonality=yes
MemoryDenyWriteExecute=yes
MountFlags=private
NoNewPrivileges=yes
PIDFile=/run/esdm-server.pid
PrivateMounts=no
PrivateNetwork=yes
PrivateTmp=yes
PrivateUsers=no
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=-/
ReadWritePaths=/run
RemoveIPC=yes
Restart=on-failure
RestartSec=5s
RestrictAddressFamilies=AF_UNIX
# pid: allow the server to fork itself into an isolating PID namespace when
# it is started with --pid_namespace (disabled by default)
RestrictNamespaces=mnt cgroup net pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# @system-service covers the syscalls the server needs (unshare/setns via
# @process, mlockall via @memlock, setrlimit/setpriority via @resources and the
# set[ug]id family via @setuid), so only the clearly dangerous groups are
# denied. @privileged must NOT be denied here: it also contains the set[ug]id /
# setgroups family the server uses to drop privileges, and a deny overrides the
# @system-service allow. @system-service already excludes the truly dangerous
# privileged calls (bpf, kexec, init_module, ...).
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
UMask=0077

[Install]
WantedBy=basic.target
Alias=esdm-server.service
